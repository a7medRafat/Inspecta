rules_version = '2';

// Role checks run on the server for every read and write (BR-01.3).
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Signed in, has a profile, and hasn't been deactivated (BR-01.4).
    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().active == true;
    }

    function hasRole(role) {
      return isActive() && profile().role == role;
    }

    match /users/{uid} {
      // Everyone can read their own profile, even when deactivated, so the
      // app can notice and sign them out. Coordinators read inspectors to
      // assign jobs; admins read everyone.
      allow read: if (signedIn() && request.auth.uid == uid)
        || hasRole('admin')
        || (hasRole('coordinator') && resource.data.role == 'inspector');

      // A user may only stamp their own lastLogin with the server time.
      // Feature 04: a coordinator may mark/clear an inspector's leave —
      // only that one field, only on an inspector's profile.
      allow update: if hasRole('admin')
        || (isActive()
            && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin'])
            && request.resource.data.lastLogin == request.time)
        || (hasRole('coordinator')
            && resource.data.role == 'inspector'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['onLeaveUntil']));

      allow create, delete: if hasRole('admin');
    }

    match /requests/{id} {
      // Feature 02's inbox is the supervisor's; other roles only get a
      // read-only view once a job is further along (00-overview.md's
      // permissions matrix — "View any job (read-only)").
      allow read: if hasRole('supervisor')
        || hasRole('coordinator')
        || hasRole('technical_manager')
        || hasRole('admin')
        // Feature 05: an inspector reads only jobs assigned to them —
        // the app always queries `where inspectorId == uid` to match.
        || (hasRole('inspector') && resource.data.inspectorId == request.auth.uid);

      // BR-02.9: only supervisors edit request details.
      allow create, delete: if hasRole('supervisor');

      // Feature 04: a coordinator may only assign an inspector to a job
      // that's already quote-accepted, and only by touching the
      // assignment fields (plus the status/history write that goes with
      // them) — everything else about a request stays supervisor-owned.
      allow update: if hasRole('supervisor')
        || (hasRole('coordinator')
            && resource.data.status == 'quote_accepted'
            && request.resource.data.status == 'assigned'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'status', 'inspectorId', 'scheduledAt', 'assignmentNote',
               ]))
        // Feature 05: the assigned inspector accepts, declines (handing
        // the job back to the coordinator's queue) or starts their own
        // job — each move touches only the fields it needs.
        || (hasRole('inspector') && resource.data.inspectorId == request.auth.uid
            && (
                 (resource.data.status == 'assigned'
                   && request.resource.data.status == 'task_accepted'
                   && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
                 || (resource.data.status == 'assigned'
                   && request.resource.data.status == 'quote_accepted'
                   && request.resource.data.inspectorId == null
                   && request.resource.data.scheduledAt == null
                   && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'status', 'inspectorId', 'scheduledAt',
                      ]))
                 || (resource.data.status == 'task_accepted'
                   && request.resource.data.status == 'in_progress'
                   && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
                 || (resource.data.status == 'in_progress'
                   && request.resource.data.status == 'certificate_submitted'
                   && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
                 // Feature 05: resubmitting after a technical manager
                 // sends a certificate back for changes.
                 || (resource.data.status == 'certificate_returned'
                   && request.resource.data.status == 'certificate_submitted'
                   && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
               ));
    }

    match /certificates/{id} {
      // Feature 05: one certificate per job (doc id == the request's id),
      // owned by the inspector it's assigned to. Ownership is checked
      // against the *request* doc, not the certificate doc itself — the
      // certificate doesn't exist yet the first time the inspector opens
      // the screen (`resource` is null for a read of a nonexistent doc,
      // so checking `resource.data` directly would fail closed).
      function ownsJob() {
        return get(/databases/$(database)/documents/requests/$(id)).data.inspectorId == request.auth.uid;
      }

      allow read: if hasRole('supervisor')
        || hasRole('coordinator')
        || hasRole('technical_manager')
        || hasRole('admin')
        || (hasRole('inspector') && ownsJob());

      allow create: if hasRole('inspector')
        && ownsJob()
        && request.resource.data.inspectorId == request.auth.uid;

      // Editable while drafting, and again after a technical manager
      // sends it back — locked at every other point in the job's
      // lifecycle. No separate flag on the certificate itself needed.
      allow update: if hasRole('inspector')
        && ownsJob()
        && (get(/databases/$(database)/documents/requests/$(id)).data.status == 'in_progress'
            || get(/databases/$(database)/documents/requests/$(id)).data.status == 'certificate_returned');

      allow delete: if false;
    }

    match /requests/{id}/events/{eventId} {
      // 00-overview.md §8: every status change is logged and can't be
      // edited — append-only, same readers as the request itself.
      allow read: if hasRole('supervisor')
        || hasRole('coordinator')
        || hasRole('technical_manager')
        || hasRole('admin');
      // A coordinator's assignment write, or an inspector's own
      // accept/decline/start write, logs an event alongside it (see
      // requests/{id}'s update rule above).
      allow create: if hasRole('supervisor') || hasRole('coordinator') || hasRole('inspector');
      allow update, delete: if false;
    }

    match /clients/{id} {
      // Same readers as requests/quotations (00-overview.md's
      // permissions matrix — clients are shared reference data, not
      // supervisor-owned).
      allow read: if hasRole('supervisor')
        || hasRole('coordinator')
        || hasRole('technical_manager')
        || hasRole('admin');

      // Only supervisors maintain the roster (BR-02.4/02.9's spirit —
      // matching senders and keeping client records is their job).
      allow create, update: if hasRole('supervisor');
      allow delete: if false;
    }

    match /quotations/{id} {
      // Same readers as the request it belongs to (Feature 03 §5).
      allow read: if hasRole('supervisor')
        || hasRole('coordinator')
        || hasRole('technical_manager')
        || hasRole('admin');

      // BR-03.4: a sent quotation's price/items/type are immutable.
      // Creating is always allowed. Updating is allowed either while the
      // doc is still a draft (covers the draft→sent transition, which
      // can touch any field), or — once sent — only for the narrow set
      // of fields BR-03.6's client-response logging and a reminder
      // timestamp touch; nothing else may change after sending.
      allow create: if hasRole('supervisor');
      allow update: if hasRole('supervisor')
        && (resource.data.status == 'draft'
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'status', 'clientResponseOutcome', 'clientCounterPricePiastres',
                 'clientResponseNote', 'clientRespondedAt', 'lastReminderAt', 'updatedAt',
               ]));
      allow delete: if false;
    }

    // Deny everything else until each feature adds its own rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
